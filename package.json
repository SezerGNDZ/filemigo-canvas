{
  "name": "filemigo-canvas",
  "version": "0.3.0",
  "description": "Filemigo diagram toolkit and local MCP server",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "bin": {
    "filemigo-mcp": "./src/mcp.mjs"
  },
  "files": [
    "src",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node src/mcp.mjs",
    "test": "node --test tests/*.test.mjs",
    "example": "node examples/render.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/latecafe-tech/filemigo-canvas.git"
  },
  "homepage": "https://filemigo.com/developers/",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "zod": "4.6.5"
  },
  "author": "Late Cafe Games",
  "contributors": [
    {
      "name": "SezerGNDZ",
      "url": "https://github.com/SezerGNDZ"
    }
  ]
}
